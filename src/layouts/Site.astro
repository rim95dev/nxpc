---
import '../styles/theme.css';
import { RPC_URL } from '../lib/chain';
import { createFmt } from '../lib/format';
import { dict, pathFor, LANGS, DEFAULT_LANG, type Lang, type Page } from '../i18n';
import type { Head } from '../lib/reads';

interface Props {
  lang: Lang;
  page: Page;
  head: Head;
  takenAt: number;
  rpcError: string | null;
  title?: string;
  description?: string;
}

const { lang, page, head, takenAt, rpcError, title, description } = Astro.props;
const t = dict(lang);
const F = createFmt(lang);
const base = import.meta.env.BASE_URL;
/* With only one locale, neither the switch button nor hreflang means anything. */
const other = LANGS.find((l) => l !== lang) ?? null;

const canonical = new URL(pathFor(lang, base, page), Astro.site).href;
/* Card image for link previews. Scrapers take absolute URLs only, and implementations
   that cannot read WebP are still out there, so this stays PNG. It is 720 square, so the
   Twitter card is summary — summary_large_image expects 2:1 and would crop a square. */
const ogImage = new URL(`${base.replace(/\/$/, '')}/nxpc-coin.png`, Astro.site).href;

const PAGES: { key: Page; label: string }[] = [
  { key: 'supply', label: t.nav.supply },
  { key: 'addresses', label: t.nav.addresses },
];

const clientI18n = JSON.stringify({
  term: t.term, foot: t.foot, rpc: t.rpc, themeLabel: t.themeLabel,
  summary: t.table.summary, chart: t.chart, seg: t.seg, addr: t.addr,
  bridge: t.bridge, range: t.range,
});
---

<html lang={t.htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title ?? t.title}</title>
  <meta name="description" content={description ?? t.description} />
  <link rel="canonical" href={canonical} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={t.brand} />
  <meta property="og:title" content={title ?? t.title} />
  <meta property="og:description" content={description ?? t.description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={t.ogLocale} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="720" />
  <meta property="og:image:height" content="720" />
  <meta property="og:image:alt" content="NXPC" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title ?? t.title} />
  <meta name="twitter:description" content={description ?? t.description} />
  <meta name="twitter:image" content={ogImage} />

  {LANGS.length > 1 && (
    <>
      {LANGS.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(pathFor(l, base, page), Astro.site).href} />
      ))}
      <link rel="alternate" hreflang="x-default" href={new URL(pathFor(DEFAULT_LANG, base, page), Astro.site).href} />
    </>
  )}
  <link rel="icon" type="image/svg+xml" href={`${base.replace(/\/$/, '')}/favicon.svg`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Roboto+Mono:wght@400;500;700&family=Sofia+Sans+Condensed:wght@600;700;800&family=Noto+Sans+KR:wght@400;500;700&display=swap" />
  {/*
    Must run before paint — run it later and the opposite theme flashes for one frame.
    data-theme-ready is attached after the first paint: if transitions are already on
    before that, the initial render animates in.
  */}
  <script is:inline>
    (function () {
      try {
        // Two states only. If the stored value is missing or bogus, light is the default.
        var s = localStorage.getItem('msu-theme');
        if (s !== 'dark') s = 'light';
        var r = document.documentElement;
        r.setAttribute('data-theme-setting', s);
        r.setAttribute('data-color-mode', s);
      } catch (e) {}
    })();
  </script>
</head>
<body>

<!-- Stays until wallets.yaml and addresses.yaml carry real addresses. -->
<p class="preview-bar" role="status">{t.preview}</p>

<slot name="notice" />

<header class="topbar">
  <div class="wrap topbar-in">
    {/* The four petals are the MSU primary mark. Keeping it inline saves one request
        and lets it follow the theme switch — the file is the same drawing as public/favicon.svg. */}
    <a class="brand" href={pathFor(lang, base)} aria-label={t.brand}>
      <svg class="brand-mark" viewBox="28 -3.35 296 296" role="img" aria-hidden="true">
        <path d="M231.709 82.3629C216.658 66.137 205.176 46.8884 194.828 15.3182C191.679 5.72541 184.143 0.666626 175.978 0.666626C167.813 0.666626 160.277 5.72541 157.128 15.3182C152.006 30.9354 146.612 43.5089 140.65 54.2142L194.555 144.643L231.688 82.3629H231.709Z" fill="var(--mint)"/>
        <path d="M140.67 54.2169C134.099 66.0348 126.837 75.5646 118.461 84.2968C101.627 101.866 80.1949 114.964 46.6516 125.796C37.0588 128.902 32 136.48 32 144.645C32 152.811 37.0588 160.389 46.6516 163.495C80.1949 174.347 101.627 187.425 118.461 204.994C126.816 213.705 134.078 223.256 140.649 235.053L194.553 144.645L140.649 54.2169H140.67Z" fill="var(--blue)"/>
        <path d="M305.348 125.813C271.805 114.961 250.373 101.883 233.539 84.3141C232.93 83.6844 232.321 83.0127 231.733 82.3829L194.601 144.663L231.733 206.963C232.342 206.313 232.93 205.662 233.539 205.032C250.373 187.463 271.805 174.365 305.348 163.533C314.941 160.427 320 152.849 320 144.684C320 136.518 314.941 128.941 305.348 125.834V125.813Z" fill="var(--pink)"/>
        <path d="M140.668 235.047C146.629 245.773 152.045 258.347 157.167 273.964C160.315 283.557 167.851 288.615 176.017 288.615C184.182 288.615 191.718 283.557 194.866 273.964C205.215 242.394 216.697 223.145 231.747 206.919L194.614 144.618L140.71 235.026L140.668 235.047Z" fill="var(--purple)"/>
      </svg>
    </a>

    <nav class="tabs" aria-label={t.brand}>
      {PAGES.map((p) => (
        <a
          class={`tab ${p.key === page ? 'is-on' : ''}`}
          href={pathFor(lang, base, p.key)}
          aria-current={p.key === page ? 'page' : undefined}
        >{p.label}</a>
      ))}
    </nav>

    <div class="topbar-right">
      <div id="chainPill" class={`pill ${rpcError ? 'pill-bad' : 'pill-ok'}`} data-rpc={RPC_URL}>
        <span class="dot"></span>
        {rpcError ? (
          <span>{t.rpc.failed} <span class="mono">{rpcError.slice(0, 48)}</span></span>
        ) : (
          <>
            <span class="pill-k">henesys</span>
            <span class="mono">{head.chainId}</span>
            <span class="sep"></span>
            <span class="mono" id="pillBlock">#{F.full(head.blockNumber)}</span>
            <span class="sep"></span>
            <span class="mono" id="pillAge">—</span>
          </>
        )}
      </div>
      {other && <a class="lang-btn" href={pathFor(other, base, page)} hreflang={other}>{dict(other).langName}</a>}
      <button id="themeToggle" class="theme-btn" type="button" aria-pressed="false"
              aria-label={t.themeLabel.light} title={t.themeLabel.light}>
        <span class="theme-ico" data-ico="light" aria-hidden="true">☀</span>
        <span class="theme-ico" data-ico="dark" aria-hidden="true">☾</span>
      </button>
    </div>
  </div>
</header>

<main><slot /></main>

<footer class="foot">
  <div class="wrap foot-in">
    <div class="foot-block">
      <div class="foot-k">{t.foot.snapshot}</div>
      <div class="mono">{F.datetime(takenAt)}</div>
      <div class="mono dim">{t.foot.block} #{F.full(head.blockNumber)}</div>
    </div>
    <div class="foot-block">
      <div class="foot-k">{t.foot.freshness}</div>
      <div id="freshness" class="freshness" data-baked-block={head.blockNumber}>{t.foot.build}</div>
    </div>
    <div class="foot-block foot-wide">
      <p class="mono dim">{t.foot.disclaimer}</p>
    </div>
  </div>
</footer>

<script type="application/json" id="i18nData" set:html={clientI18n} is:inline />
<script>
  import { createFmt } from '../lib/format';
  import type { Lang } from '../i18n';

  const T = JSON.parse(document.getElementById('i18nData')!.textContent!);
  const lang = (document.documentElement.lang || 'en') as Lang;
  const F = createFmt(lang);
  const root = document.documentElement;

  /* ---------- Theme toggle ----------
     Two states, light / dark. Light is the default. It does not follow the system
     setting — this is a disclosure screen, so everyone seeing the same screen is better. */
  type Setting = 'light' | 'dark';
  const themeBtn = document.getElementById('themeToggle');

  const currentSetting = (): Setting =>
    root.getAttribute('data-theme-setting') === 'dark' ? 'dark' : 'light';

  function stamp(next: Setting) {
    root.setAttribute('data-theme-setting', next);
    root.setAttribute('data-color-mode', next);
    themeBtn?.setAttribute('aria-label', T.themeLabel[next]);
    themeBtn?.setAttribute('title', T.themeLabel[next]);
    themeBtn?.setAttribute('aria-pressed', String(next === 'dark'));
    try { localStorage.setItem('msu-theme', next); } catch {}
  }

  themeBtn?.addEventListener('click', () =>
    stamp(currentSetting() === 'dark' ? 'light' : 'dark'));
  stamp(currentSetting());

  // Turn transitions on after the first paint is done. Turned on any earlier, the
  // initial render animates in and looks like a flicker.
  requestAnimationFrame(() => requestAnimationFrame(() => {
    root.setAttribute('data-theme-ready', '');
  }));

  /* ---------- Freshness watch ----------
     The live layer never overwrites the canonical numbers. It only compares the baked
     block against the current one and shows how stale it is. One eth_blockNumber call. */
  const pill = document.getElementById('chainPill');
  const rpc = pill?.dataset.rpc;
  const fresh = document.getElementById('freshness');
  const bakedBlock = Number(fresh?.dataset.bakedBlock ?? 0);
  const BLOCK_TIME = 2.08; // seconds. Measured 2026-08-25

  async function checkFreshness() {
    if (!rpc || document.hidden) return;
    try {
      const res = await fetch(rpc, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ jsonrpc: '2.0', id: 1, method: 'eth_blockNumber', params: [] }),
      });
      const now = Number(JSON.parse(await res.text()).result);
      const behind = now - bakedBlock;
      const mins = (behind * BLOCK_TIME) / 60;

      const blockEl = document.getElementById('pillBlock');
      if (blockEl) blockEl.textContent = `#${F.full(now)}`;
      const ageEl = document.getElementById('pillAge');
      if (ageEl) ageEl.textContent = behind > 0 ? `${T.rpc.behind} −${F.full(behind)}` : T.rpc.latest;

      if (fresh) {
        const stale = mins > 60;
        fresh.className = `freshness ${stale ? 'is-stale' : 'is-fresh'}`;
        fresh.textContent = stale
          ? `${T.foot.stale} · ${Math.round(mins / 60)}${T.foot.hour} ${T.foot.ago}`
          : `${T.foot.fresh} · ${Math.round(mins)}${T.foot.min} ${T.foot.ago}`;
      }
    } catch {
      if (fresh) { fresh.className = 'freshness is-stale'; fresh.textContent = T.foot.rpcCheckFailed; }
    }
  }
  checkFreshness();
  setInterval(checkFreshness, 30_000);
  document.addEventListener('visibilitychange', () => { if (!document.hidden) checkFreshness(); });
</script>

</body>
</html>
