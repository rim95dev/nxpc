---
/* Supply page for the non-default locales. Only as many pages as LANGS holds get
   generated — right now that is just en, so this route produces no pages. */
import SupplyView from '../../components/SupplyView.astro';
import { LANGS, DEFAULT_LANG, type Lang } from '../../i18n';

export function getStaticPaths() {
  return LANGS.filter((l) => l !== DEFAULT_LANG).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---
<SupplyView lang={lang} />
